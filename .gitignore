# macOS
.DS_Store

# Secrets/env files (must never be committed)
.env
.env.*

# Dependency/runtime artifacts
node_modules/

# Logs
*.log
logs/

# VS Code runtime/user data that must never be committed
workspaceStorage/
globalStorage/
storage.json

# Caches and temp
.cache/
.tmp/
tmp/

# Local backup artifacts generated by install scripts
*.bak-*
